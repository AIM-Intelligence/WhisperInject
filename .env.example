# Copy this file to `.env` and fill in your credentials.

# OpenAI API key — used by the LLM judge (Stage 1) and StrongREJECT evaluation.
OPENAI_API_KEY=sk-...

# HuggingFace access token — required to download gated models
# (e.g. Gemma-3n, LlamaGuard-3-8B).
HUGGINGFACE_ACCESS_TOKEN=hf_...

# Optional: override the default judge model (default: gpt-4o-mini).
# JUDGE_LLM_MODEL=gpt-4o
